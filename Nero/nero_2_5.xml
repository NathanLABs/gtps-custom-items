        <RenderOptions>
            <Default>
                <Set name="JumpEndStateRange">100</Set>
                <Set name="ClothingOffsetFromShoes">10000</Set>
                <Set name="IsRidingBird">true</Set>
                <Set name="IsVehicle">true</Set>
                <Set name="IsToRenderPants">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
                <Set name="UserNameOffset">35</Set>
                <Set name="IncludeAllActions">true</Set>
                <Set name="HideAngelOnDeath">true</Set>
                <Set name="HideAvatarOnDeath">true</Set>
                <Set name="IgnorePunchTypeCheck">true</Set>
            </Default>

            <Override overrideOnState="Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="UserNameOffset">70</Set>
            </Override>
        </RenderOptions>
    </Data>

    <RenderRules>
        <Update>
            <AvatarTransform class="FootPosition" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="foot1dy">0</Set>
                <Set name="foot2dy">0</Set>
                <Set name="foot1y">0</Set>
                <Set name="foot2y">0</Set>
            </AvatarTransform>

            <AvatarTransform class="ActionUpdate" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="action">NOD</Set>
            </AvatarTransform>

            <AvatarTransform class="Facing" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="invert">false</Set>
            </AvatarTransform>
        </Update>

        <RenderInFront>
            <StopIf>
                <IsVariableBool name="isMannequin">true</IsVariableBool>
                <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
            </StopIf>

            <SpriteRender name="nero_body" offset="0,-9975" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Land|Motion.dance1|Motion.dance2|Motion.dance3|Motion.Respawn" scale="0.55,0.55" />
            <SpriteRender name="nero_punch_body" offset="0,-9975" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Punch" scale="0.55,0.55" />
            <SpriteRender name="nero_punch_fx" offset="0,-9975" alignment="DOWN_CENTER" drawShadow="false" onState="Motion.Punch" scale="0.55,0.55" />
        </RenderInFront>

        <RenderShoes>
            <StopIf>
                <IsSitting>true</IsSitting>
                <IsSleepingOnaBed>true</IsSleepingOnaBed>
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
            </StopIf>
        </RenderShoes>
    </RenderRules>
