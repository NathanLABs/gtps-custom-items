				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kirito_Death" sprite="kirito_death" animTime="720" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kirito_Respawn" sprite="kirito_respawn" animTime="630" isLoop="false" playOnState="Motion.Respawn">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kirito_PreIdle" sprite="kirito_reveal" animTime="800" isLoop="false" playOnState="Reveal.No" autoPlay="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kirito_Punch_fx" sprite="kirito_punch_fx" animTime="700" isLoop="true" playOnState="Motion.Punch">
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
