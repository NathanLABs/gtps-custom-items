			</SpriteAnimation>
			<SpriteAnimation name="dance_anim1" sprite="kirito_body" animTime="360" isLoop="false" playOnState="Motion.dance1">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="dance_anim2" sprite="kirito_body" animTime="360" isLoop="false" playOnState="Motion.dance2">
