			</Override>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="action">NOD</Set>
			</AvatarTransform>
			<AvatarTransform class="Facing" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="invert">false</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.Idle|Motion.Dance" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.Move" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.Jump" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.Fall" scale="0.25,0.25" />
			<SpriteRender name="kirito_punch_body" offset="0,-10049" drawShadow="true" onState="Motion.Punch" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.dance1" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.dance2" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.dance3" scale="0.25,0.25" />
			<SpriteRender name="kirito_respawn" offset="0,-10061" drawShadow="true" onState="Motion.Respawn" scale="0.25,0.25" />
			<SpriteRender name="kirito_body" offset="0,-10049" drawShadow="true" onState="Motion.Down" scale="0.25,0.25" />
			<SpriteRender name="kirito_reveal" offset="0,-10061" drawShadow="true" onState="Motion.Spawn" scale="0.25,0.25" />
			<SpriteRender name="kirito_punch_fx" offset="47,-10054" drawShadow="false" onState="Motion.Punch" scale="0.4,0.4" />
		</RenderInFront>
		<RenderShoes>
