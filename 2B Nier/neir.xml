<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
    <Data>
        <Sprite name="2b_sprite" fileName="game/2b.rttex" textureSize="128"/>
        <Sprite name="s_slash" fileName="game/2b_eff.rttex" textureSize="128"/>
        <Sprite name="s_hit" fileName="game/2b_eff.rttex" textureSize="128"/>

        <StateMachines>
            <StateMachine name="Motion">
                <States>
                    <State name="Idle"/>
                    <State name="Move"/>
                    <State name="Jump"/>
                    <State name="Fall"/>
                    <State name="Punch"/>
                    <State name="Respawn"/>
                </States>
                <Transitions>
                    <Transition to="Idle" from="Fall|Move|Jump|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                            <IsVariableBool name="isAttacking">false</IsVariableBool>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Move" from="Jump|Fall|Idle|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Jump" from="Idle|Move|Fall|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Fall" from="Jump|Idle|Move|Punch">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Punch" from="Idle|Move|Jump|Fall">
                        <Condition type="and">
                            <IsAction>PUNCH</IsAction>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <Animations>
            <SpriteAnimation name="2b_Idle" playOnState="Motion.Idle" sprite="2b_sprite" animTime="1600" isLoop="true">
                <Frame>1,3</Frame><Frame>2,3</Frame><Frame>3,3</Frame>
                <Frame>4,3</Frame><Frame>5,3</Frame><Frame>6,3</Frame><Frame>7,3</Frame>
                <Frame>8,3</Frame><Frame>9,3</Frame><Frame>10,3</Frame><Frame>11,3</Frame>
                <Frame>12,3</Frame><Frame>13,3</Frame><Frame>14,3</Frame><Frame>15,3</Frame><Frame>16,3</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="2b_Walk" playOnState="Motion.Move" sprite="2b_sprite" animTime="1000" isLoop="true">
                <Frame>4,2</Frame><Frame>5,2</Frame><Frame>6,2</Frame><Frame>7,2</Frame>
                <Frame>8,2</Frame><Frame>9,2</Frame><Frame>10,2</Frame><Frame>11,2</Frame>
                <Frame>12,2</Frame><Frame>13,2</Frame><Frame>14,2</Frame><Frame>15,2</Frame><Frame>16,2</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="2b_Jump" playOnState="Motion.Jump" sprite="2b_sprite" animTime="450">
                <Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame><Frame>7,1</Frame><Frame>8,1</Frame><Frame>9,1</Frame><Frame>10,1</Frame><Frame>11,1</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="2b_Fall" playOnState="Motion.Fall" sprite="2b_sprite" animTime="450"> 
                <Frame>12,1</Frame><Frame>13,1</Frame><Frame>14,1</Frame><Frame>15,1</Frame><Frame>16,1</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="2b_Punch" playOnState="Motion.Punch" sprite="2b_sprite" animTime="500" isLoop="true">
                <Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame>
                <Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame>
                <Frame>8,0</Frame><Frame>9,0</Frame><Frame>10,0</Frame><Frame>11,0</Frame>
                <Frame>12,0</Frame><Frame>13,0</Frame><Frame>14,0</Frame><Frame>15,0</Frame><Frame>16,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="shotAnim" sprite="s_slash" autoPlay="true" animTime="300" isLoop="false">
                <Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame>
                <Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="hitAnim" sprite="s_hit" animTime="350" isLoop="false">
                <Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame>
                <Frame>4,0</Frame><Frame>5,0</Frame><Frame>6,0</Frame><Frame>7,0</Frame><Frame>8,0</Frame>
            </SpriteAnimation>
        </Animations>

        <ParticleSystems>
            <ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
                <Emitter>
                    <Set name="offset">30,-10033</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="lifeTime">0.3</Set>
                    <Set name="emissionInterval">0.3</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">s_slash</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">0.3</Set>
                    <Set name="rotateWithVelocity">true</Set>
                    <Set name="initialScale">0.7,0.7</Set>
                    <Set name="initialAlpha">1</Set>
                    <Set name="finalAlpha">0</Set>
                    <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1.0"/>
                </Particle>
            </ParticleSystem>

            <ParticleSystem name="ps_hit" updateStage="OnDamagedTile">
                <Emitter>
                    <Set name="offset">0,-4</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                    <Set name="lifeTime">0.35</Set>
                    <Set name="emissionInterval">0.35</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">s_hit</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">0.35</Set>
                    <Curve name="initialScale">
                        <KeyFrame>0, 0.15, 0.15</KeyFrame>
                        <KeyFrame>0.35, 0.45, 0.45</KeyFrame>
                        <KeyFrame>1.0, 0.25, 0.25</KeyFrame>
                    </Curve>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.75, 1</KeyFrame>
                        <KeyFrame>1.0, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>

        <RenderOptions>
            <Default>
                <Set name="JumpEndStateRange">100</Set>
                <Set name="ClothingOffsetFromShoes">10000</Set>
                <Set name="IsRidingBird">true</Set>
                <Set name="IsVehicle">true</Set>
                <Set name="UserNameOffset">30</Set>
                <Set name="ShoesHidesBodyLegs">true</Set>
                <Set name="IsToRenderPants">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="PunchSoundOverride">audio/mp3/shiroko_shot.mp3</Set>
                <Set name="DefaultPunchSound">audio/mp3/shiroko_shot.mp3</Set>
                <Set name="PlayDefaultPunchAudio">true</Set>
            </Default>
        </RenderOptions>
    </Data>

    <RenderRules>
        <RenderInFront>
            <StopIf>
                <IsVariableBool name="isMannequin">true</IsVariableBool>
                <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
            </StopIf>           
            <SpriteRender name="2b_sprite" offset="0,-10027" drawShadow="true" scale="0.6,0.6" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>           
            <ParticleSystemRender name="punch_projectile"/>
            <ParticleSystemRender name="ps_hit"/>
        </RenderInFront>

        <OnPunchStart>
            <ParticleSystemUpdate name="punch_projectile"/>
        </OnPunchStart>

        <OnPunchUpdate>
            <AvatarTransform class="Face">
                <Set name="face">MAD</Set>
            </AvatarTransform>
        </OnPunchUpdate>

        <OnDamagedTile>
            <ParticleSystemUpdate name="ps_hit"/>
        </OnDamagedTile>

        <SwitchOffClothingParticles>
            <ParticleSystemOff name="punch_projectile"/>
            <ParticleSystemOff name="ps_hit"/>
        </SwitchOffClothingParticles>
    </RenderRules>
</ItemRenderer>