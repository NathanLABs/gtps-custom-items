			<SpriteRender name="akiha_reveal" offset="0,-10044" drawShadow="true" onState="Motion.Spawn" scale="0.25,0.25" />
			<SpriteRender name="akiha_punch_fx" offset="50,-10060" drawShadow="false" onState="Motion.Punch" scale="0.17,0.17" />
