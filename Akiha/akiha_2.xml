			</SpriteAnimation>
			<SpriteAnimation name="akiha_Punch_fx" sprite="akiha_punch_fx" animTime="700" isLoop="true" playOnState="Motion.Punch">
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
