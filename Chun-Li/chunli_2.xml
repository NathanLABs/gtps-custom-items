<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
    <Data>
        <!--
          Chun-Li - perbaikan:
          - Posisi: semua SpriteRender offset y -9992 (sebelumnya -9985) supaya kaki pas di atas tanah.
            Makin negatif = makin naik (arah sama dgn Kula -10050 / Akiha -10044).
          - Dance: 28 frame berurutan dari animasi asli CvS2 #229-256 (sebelumnya 10 frame acak/loncat-loncat), 3 bagian ~50 ms/frame.
            UserNameOffset saat dance diturunkan (55 -> 42). Motion.Dance sekarang ikut digambar (tidak ada frame kosong).
          - Death + Respawn pola Kula/Akiha: HasDeathParticles + ps_chunliDeath (OnKilled) memutar chunli_Death,
            lalu Motion.Respawn memutar chunli_Respawn (bangun kip-up).
          - Punch combo (44 frame) sama seperti sebelumnya, tanpa efek.
        -->
        <Sprite name="chunli_body" fileName="game/chunli_body.rttex" textureSize="200,206" frame="0,0" />
        <Sprite name="chunli_body_2" fileName="game/chunli_body_2.rttex" textureSize="200,206" frame="0,0" />
        <Sprite name="chunli_reveal" fileName="game/chunli_body_2.rttex" textureSize="200,206" frame="0,1" />
        <Sprite name="chunli_respawn" fileName="game/chunli_body_2.rttex" textureSize="200,206" frame="0,5" />
        <Sprite name="chunli_death" fileName="game/chunli_death.rttex" textureSize="200,206" frame="0,0" />
        <Sprite name="chunli_punch_body" fileName="game/chunli_punch_body.rttex" textureSize="240,206" frame="0,0" />

        <StateMachines>
            <StateMachine name="Motion">
                <States>
                    <State name="Spawn" />
                    <State name="Idle" />
                    <State name="Move" />
                    <State name="Jump" />
                    <State name="Fall" />
                    <State name="Land" />
                    <State name="Punch" />
                    <State name="Dance" />
                    <State name="dance1" />
                    <State name="dance2" />
                    <State name="dance3" />
                    <State name="Respawn" />
                </States>
                <Transitions>
                    <Transition to="Idle" from="Punch|Jump|Move|Dance|dance1|dance2|dance3">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                            <IsVariableBool name="isAttacking">false</IsVariableBool>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Move" from="Jump|Land|Idle|Punch|Dance|dance1|dance2|dance3">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|dance1|dance2|dance3|Land">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|dance1|dance2|dance3|Land">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Land" from="Fall">
                        <Condition>
                            <IsVariableBool name="onGround">true</IsVariableBool>
                        </Condition>
                    </Transition>
                    <Transition to="Idle" from="Land">
                        <Condition type="and">
                            <IsAnimationFinished>chunli_Land</IsAnimationFinished>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Move" from="Land">
                        <Condition type="and">
                            <IsAnimationFinished>chunli_Land</IsAnimationFinished>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>
                    <Transition to="Punch" from="Idle|Move|Jump|Fall|Land|Dance|dance1|dance2|dance3">
                        <Condition type="and">
                            <IsAction>PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="Dance" from="Move|Idle|Punch|Jump|Fall|Land">
                        <Condition type="or">
                            <IsAction>DANCE</IsAction>
                            <IsAction>DANCE_DAB</IsAction>
                            <IsAction>DANCE_FLOSS</IsAction>
                            <IsAction>DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>
                    <Transition to="dance1" from="Dance|dance3">
                        <Condition type="or">
                            <IsAnimationFinished>dance_anim3</IsAnimationFinished>
                            <IsState>Motion.Dance</IsState>
                        </Condition>
                    </Transition>
                    <Transition to="dance2" from="dance1">
                        <Condition>
                            <IsAnimationFinished>dance_anim1</IsAnimationFinished>
                        </Condition>
                    </Transition>
                    <Transition to="dance3" from="dance2">
                        <Condition>
                            <IsAnimationFinished>dance_anim2</IsAnimationFinished>
                        </Condition>
                    </Transition>
                    <Transition to="Idle" from="Spawn">
                        <Condition>
                            <IsAnimationFinished>chunli_PreIdle</IsAnimationFinished>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>

            <StateMachine name="Reveal">
                <States>
                    <State name="No" />
                    <State name="Done" />
                </States>
                <Transitions>
                    <Transition to="Done" from="No">
                        <Condition>
                            <IsAnimationFinished>chunli_PreIdle</IsAnimationFinished>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <Animations>
            <SpriteAnimation name="chunli_PreIdle" sprite="chunli_reveal" isLoop="false" autoPlay="true" animTime="700" playOnState="Reveal.No">
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Idle" sprite="chunli_body" isLoop="true" animTime="900" playOnState="Motion.Idle">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
                <Frame>9,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Move" sprite="chunli_body" isLoop="true" animTime="720" playOnState="Motion.Move">
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
                <Frame>6,1</Frame>
                <Frame>7,1</Frame>
                <Frame>8,1</Frame>
                <Frame>9,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>3,2</Frame>
                <Frame>4,2</Frame>
                <Frame>5,2</Frame>
                <Frame>6,2</Frame>
                <Frame>7,2</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Jump" sprite="chunli_body_2" isLoop="false" animTime="380" playOnState="Motion.Jump">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Fall" sprite="chunli_body" isLoop="true" animTime="320" playOnState="Motion.Fall">
                <Frame>0,4</Frame>
                <Frame>1,4</Frame>
                <Frame>2,4</Frame>
                <Frame>3,4</Frame>
                <Frame>4,4</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Land" sprite="chunli_body" isLoop="false" animTime="260" playOnState="Motion.Land">
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
                <Frame>3,3</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Punch" sprite="chunli_punch_body" isLoop="true" animTime="2000" playOnState="Motion.Punch">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
                <Frame>6,1</Frame>
                <Frame>7,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>3,2</Frame>
                <Frame>4,2</Frame>
                <Frame>5,2</Frame>
                <Frame>6,2</Frame>
                <Frame>7,2</Frame>
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
                <Frame>3,3</Frame>
                <Frame>4,3</Frame>
                <Frame>5,3</Frame>
                <Frame>6,3</Frame>
                <Frame>7,3</Frame>
                <Frame>0,4</Frame>
                <Frame>1,4</Frame>
                <Frame>2,4</Frame>
                <Frame>3,4</Frame>
                <Frame>4,4</Frame>
                <Frame>5,4</Frame>
                <Frame>6,4</Frame>
                <Frame>7,4</Frame>
                <Frame>0,5</Frame>
                <Frame>1,5</Frame>
                <Frame>2,5</Frame>
                <Frame>3,5</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Respawn" sprite="chunli_respawn" isLoop="false" animTime="800" playOnState="Motion.Respawn">
                <Frame>0,5</Frame>
                <Frame>1,5</Frame>
                <Frame>2,5</Frame>
                <Frame>3,5</Frame>
                <Frame>4,5</Frame>
                <Frame>5,5</Frame>
                <Frame>6,5</Frame>
                <Frame>7,5</Frame>
                <Frame>8,5</Frame>
                <Frame>9,5</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="dance_anim1" sprite="chunli_body_2" isLoop="false" animTime="500" playOnState="Motion.dance1">
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>3,2</Frame>
                <Frame>4,2</Frame>
                <Frame>5,2</Frame>
                <Frame>6,2</Frame>
                <Frame>7,2</Frame>
                <Frame>8,2</Frame>
                <Frame>9,2</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="dance_anim2" sprite="chunli_body_2" isLoop="false" animTime="450" playOnState="Motion.dance2">
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
                <Frame>3,3</Frame>
                <Frame>4,3</Frame>
                <Frame>5,3</Frame>
                <Frame>6,3</Frame>
                <Frame>7,3</Frame>
                <Frame>8,3</Frame>
            </SpriteAnimation>
            <SpriteAnimation name="dance_anim3" sprite="chunli_body_2" isLoop="false" animTime="450" playOnState="Motion.dance3">
                <Frame>0,4</Frame>
                <Frame>1,4</Frame>
                <Frame>2,4</Frame>
                <Frame>3,4</Frame>
                <Frame>4,4</Frame>
                <Frame>5,4</Frame>
                <Frame>6,4</Frame>
                <Frame>7,4</Frame>
                <Frame>8,4</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="chunli_Death" sprite="chunli_death" animTime="900" isLoop="false">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
                <Frame>9,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
                <Frame>6,1</Frame>
            </SpriteAnimation>
        </Animations>

        <ParticleSystems>
            <ParticleSystem name="ps_chunliDeath" updateStage="OnKilled" renderStage="RenderInFront">
                <Emitter>
                    <Set name="offset">0,-44</Set>
                    <Set name="lifeTime">0.01</Set>
                    <Set name="particlesPerEmission">1</Set>
                    <Set name="particlesToEmit">1</Set>
                </Emitter>
                <Particle usePlayerFacing="true">
                    <Set name="sprite">chunli_death</Set>
                    <Set name="renderAlignment">CENTER</Set>
                    <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
                    <Set name="lifeTime">1.0</Set>
                    <Set name="initialScale">0.62,0.62</Set>
                    <Set name="initialVelocity">0,0</Set>
                    <Set name="finalVelocity">0,0</Set>
                </Particle>
            </ParticleSystem>
        </ParticleSystems>

        <RenderOptions>
            <Default>
                <Set name="JumpEndStateRange">100</Set>
                <Set name="ClothingOffsetFromShoes">10000</Set>
                <Set name="IsRidingBird">true</Set>
                <Set name="IsVehicle">true</Set>
                <Set name="IsToRenderPants">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
                <Set name="UserNameOffset">22</Set>
                <Set name="IncludeAllActions">true</Set>
                <Set name="HasDeathParticles">true</Set>
                <Set name="HideAngelOnDeath">true</Set>
                <Set name="HideAvatarOnDeath">true</Set>
                <Set name="IgnorePunchTypeCheck">true</Set>
            </Default>
            <Override overrideOnState="Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="UserNameOffset">15</Set>
            </Override>
        </RenderOptions>
    </Data>

    <RenderRules>
        <Update>
            <AvatarTransform class="FootPosition" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="foot1dy">0</Set>
                <Set name="foot2dy">0</Set>
                <Set name="foot1y">0</Set>
                <Set name="foot2y">0</Set>
            </AvatarTransform>
            <AvatarTransform class="ActionUpdate" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="action">NOD</Set>
            </AvatarTransform>
            <AvatarTransform class="Facing" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
                <Set name="invert">false</Set>
            </AvatarTransform>
        </Update>

        <RenderInFront>
            <StopIf>
                <IsVariableBool name="isMannequin">true</IsVariableBool>
                <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
            </StopIf>

            <SpriteRender name="chunli_body" offset="0,-9992" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Idle|Motion.Dance|Motion.Move|Motion.Fall|Motion.Land" scale="0.62,0.62" />
            <SpriteRender name="chunli_body_2" offset="0,-9992" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Jump|Motion.dance1|Motion.dance2|Motion.dance3" scale="0.62,0.62" />
            <SpriteRender name="chunli_punch_body" offset="0,-9992" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Punch" scale="0.62,0.62" />
            <SpriteRender name="chunli_reveal" offset="0,-9992" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Spawn" scale="0.62,0.62" />
            <SpriteRender name="chunli_respawn" offset="0,-9992" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Respawn" scale="0.62,0.62" />
        </RenderInFront>

        <RenderShoes>
            <StopIf>
                <IsSitting>true</IsSitting>
                <IsSleepingOnaBed>true</IsSleepingOnaBed>
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
            </StopIf>
        </RenderShoes>
    </RenderRules>
</ItemRenderer>
