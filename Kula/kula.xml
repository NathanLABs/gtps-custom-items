<?xml version='1.0' encoding='utf-8'?>
<ItemRenderer>
	<Data>
		<!-- Existing body/punch_body RTTEX unchanged. New death_respawn: 2048x320, cell256x160, death row0, respawn row1. Replace punch_fx RTTEX: 480x64, cell96x64, 5 projectile frames. -->
		<Sprite name="kula_body" fileName="game/kula_body.rttex" textureSize="256,160" />
		<Sprite name="kula_punch_body" fileName="game/kula_punch_body.rttex" textureSize="256,160" />
		<Sprite name="kula_punch_fx" fileName="game/kula_punch_fx.rttex" textureSize="96,64" frame="0,0" />
		<Sprite name="kula_respawn" fileName="game/kula_death_respawn.rttex" textureSize="256,160" frame="0,1" />
		<Sprite name="kula_death" fileName="game/kula_death_respawn.rttex" textureSize="256,160" frame="0,0" />
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch" />
					<State name="Dance" />
					<State name="dance1" />
					<State name="dance2" />
					<State name="dance3" />
					<State name="Respawn" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch|Dance|dance1|dance2|dance3">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch|Dance|dance1|dance2|dance3">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|dance1|dance2|dance3">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|dance1|dance2|dance3">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall|Dance|dance1|dance2|dance3">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Dance" from="Move|Idle|Punch|Jump|Fall">
						<Condition type="or">
							<IsAction>DANCE</IsAction>
							<IsAction>DANCE_DAB</IsAction>
							<IsAction>DANCE_FLOSS</IsAction>
							<IsAction>DANCE_MARCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="dance1" from="Dance|dance3">
						<Condition type="or">
							<IsAnimationFinished>dance_anim3</IsAnimationFinished>
							<IsState>Motion.Dance</IsState>
						</Condition>
					</Transition>
					<Transition to="dance2" from="dance1">
						<Condition>
							<IsAnimationFinished>dance_anim1</IsAnimationFinished>
						</Condition>
					</Transition>
					<Transition to="dance3" from="dance2">
						<Condition>
							<IsAnimationFinished>dance_anim2</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="RespawnPlayback">
				<States>
					<State name="Ready" />
					<State name="Playing" />
					<State name="Finished" />
				</States>
				<Transitions>
					<Transition to="Playing" from="Ready">
						<Condition>
							<IsState>Motion.Respawn</IsState>
						</Condition>
					</Transition>
					<Transition to="Finished" from="Playing">
						<Condition>
							<IsAnimationFinished>kula_Respawn</IsAnimationFinished>
						</Condition>
					</Transition>
					<Transition to="Ready" from="Finished">
						<Condition type="or">
							<IsState>Motion.Idle</IsState>
							<IsState>Motion.Move</IsState>
							<IsState>Motion.Jump</IsState>
							<IsState>Motion.Fall</IsState>
							<IsState>Motion.Punch</IsState>
							<IsState>Motion.Dance</IsState>
							<IsState>Motion.dance1</IsState>
							<IsState>Motion.dance2</IsState>
							<IsState>Motion.dance3</IsState>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<Animations>
			<SpriteAnimation name="kula_Idle" playOnState="Motion.Idle" sprite="kula_body" animTime="1440" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Move" playOnState="Motion.Move" sprite="kula_body" animTime="700" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
				<Frame>7,3</Frame>
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Jump" playOnState="Motion.Jump" sprite="kula_body" animTime="350" isLoop="false">
				<Frame>0,5</Frame>
				<Frame>1,5</Frame>
				<Frame>2,5</Frame>
				<Frame>3,5</Frame>
				<Frame>4,5</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Fall" playOnState="Motion.Fall" sprite="kula_body" animTime="240" isLoop="false">
				<Frame>0,6</Frame>
				<Frame>1,6</Frame>
				<Frame>2,6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Punch" playOnState="Motion.Punch" sprite="kula_punch_body" animTime="1080" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Punch_fx" sprite="kula_punch_fx" animTime="350" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="dance_anim1" playOnState="Motion.dance1" sprite="kula_body" animTime="320" isLoop="false">
				<Frame>0,7</Frame>
				<Frame>1,7</Frame>
				<Frame>2,7</Frame>
				<Frame>3,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="dance_anim2" playOnState="Motion.dance2" sprite="kula_body" animTime="320" isLoop="false">
				<Frame>4,7</Frame>
				<Frame>5,7</Frame>
				<Frame>6,7</Frame>
				<Frame>7,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="dance_anim3" playOnState="Motion.dance3" sprite="kula_body" animTime="320" isLoop="false">
				<Frame>0,8</Frame>
				<Frame>1,8</Frame>
				<Frame>2,8</Frame>
				<Frame>3,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Death" sprite="kula_death" animTime="640" isLoop="false">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kula_Respawn" sprite="kula_respawn" animTime="800" isLoop="false" playOnState="RespawnPlayback.Playing">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
			</SpriteAnimation>
		</Animations>
		<TileStampData>
			<Set name="FileName">game/particles9.rttex</Set>
			<Set name="EndFrame">28,17</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<ParticleSystems>
			<ParticleSystem name="ps_kulaIceBullet" updateStage="OnPunchStart" renderStage="RenderInFront">
				<Emitter>
					<Set name="offset">45,-10055</Set>
					<Set name="offsetFacing">true</Set>
					<Set name="delayTimer">0.30</Set>
					<Set name="lifeTime">0.65</Set>
					<Set name="emissionInterval">0.01</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">kula_punch_fx</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.35</Set>
					<Set name="initialScale">0.85,0.85</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0" />
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.85, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_kulaDeath" updateStage="OnKilled" renderStage="RenderInFront">
				<Emitter>
					<Set name="offset">0,-50</Set>
					<Set name="lifeTime">0.01</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle usePlayerFacing="true">
					<Set name="sprite">kula_death</Set>
					<Set name="renderAlignment">CENTER</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.80</Set>
					<Set name="initialScale">0.85,0.85</Set>
					<Set name="initialVelocity">0,0</Set>
					<Set name="finalVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">75</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="HideAngelOnDeath">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
			</Default>
			<Override overrideOnState="Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="UserNameOffset">120</Set>
			</Override>
		</RenderOptions>
	</Data>
	<RenderRules>
		<Update>
			<AvatarTransform class="FootPosition" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="foot1dy">0</Set>
				<Set name="foot2dy">0</Set>
				<Set name="foot1y">0</Set>
				<Set name="foot2y">0</Set>
			</AvatarTransform>
			<AvatarTransform class="ActionUpdate" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="action">NOD</Set>
			</AvatarTransform>
			<AvatarTransform class="Facing" onState="Motion.Dance|Motion.dance1|Motion.dance2|Motion.dance3">
				<Set name="invert">false</Set>
			</AvatarTransform>
		</Update>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.Idle|Motion.Dance" scale="0.85,0.85" />
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.Move" scale="0.85,0.85" />
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.Jump" scale="0.85,0.85" />
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.Fall" scale="0.85,0.85" />
			<SpriteRender name="kula_punch_body" offset="0,-10050" drawShadow="true" onState="Motion.Punch" scale="0.85,0.85" />
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.dance1" scale="0.85,0.85" />
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.dance2" scale="0.85,0.85" />
			<SpriteRender name="kula_body" offset="0,-10050" drawShadow="true" onState="Motion.dance3" scale="0.85,0.85" />
			<SpriteRender name="kula_respawn" offset="0,-10050" drawShadow="true" onState="Motion.Respawn" scale="0.85,0.85" />
		</RenderInFront>
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
	</RenderRules>
</ItemRenderer>