						</Condition>
					</Transition>
					<Transition to="Move" from="Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAnimationFinished>kuro_Punch</IsAnimationFinished>
						</Condition>
					</Transition>
					<Transition to="Move" from="Punch2">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
							<IsAction operatorType="NotEqual">DANCE</IsAction>
							<IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
							<IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
							<IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
							<IsAction operatorType="NotEqual">SLEEP</IsAction>
							<IsAnimationFinished>kuro_Punch2</IsAnimationFinished>
						</Condition>
					</Transition>
					<Transition to="Punch2" from="Punch">
						<Condition type="and">
							<IsAnimationFinished>kuro_Punch</IsAnimationFinished>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Punch2">
						<Condition type="and">
							<IsAnimationFinished>kuro_Punch2</IsAnimationFinished>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Landing" from="Jump|Fall">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Idle" from="Landing">
						<Condition type="and">
							<IsAnimationFinished>kuro_Landing</IsAnimationFinished>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Landing">
						<Condition type="and">
							<IsAnimationFinished>kuro_Landing</IsAnimationFinished>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Reveal">
				<States>
					<State name="No" />
					<State name="Done" />
				</States>
				<Transitions>
					<Transition to="Done" from="No">
						<Condition>
							<IsAnimationFinished>kuro_PreIdle</IsAnimationFinished>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Punch">
				<States>
					<State name="False" />
					<State name="True" />
				</States>
				<Transitions>
					<Transition to="True" from="False">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="False" from="True">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
