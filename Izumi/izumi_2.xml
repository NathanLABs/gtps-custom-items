<?xml version="1.0"?>
<ItemRenderer>
    <Data>
        <Sprite name="izumi_body" fileName="game/izumi_body_2.rttex" textureSize="448,480" frame="0,0" />
        <Sprite name="izumi_punch_body" fileName="game/izumi_punch_body.rttex" textureSize="448,480" frame="0,0" />

        <StateMachines>
            <StateMachine name="Motion">
                <States>
                    <State name="Idle" />
                    <State name="Move" />
                    <State name="Jump" />
                    <State name="Fall" />
                    <State name="Land" />
                    <State name="Punch" />
                    <State name="Dance" />
                    <State name="dance1" />
                    <State name="dance2" />
                    <State name="dance3" />
                    <State name="Respawn" />
                </States>

                <Transitions>
                    <Transition to="Idle" from="Punch|Jump|Move|Dance|dance1|dance2|dance3|Respawn">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                            <IsVariableBool name="isAttacking">false</IsVariableBool>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>

                    <Transition to="Move" from="Jump|Land|Idle|Punch|Dance|dance1|dance2|dance3|Respawn">
                        <Condition type="and">
                            <IsVariableBool name="onGround">true</IsVariableBool>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>

                    <Transition to="Jump" from="Idle|Move|Fall|Punch|Dance|dance1|dance2|dance3|Land|Respawn">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>

                    <Transition to="Fall" from="Jump|Idle|Move|Punch|Dance|dance1|dance2|dance3|Land|Respawn">
                        <Condition type="and">
                            <IsVariableBool name="onGround">false</IsVariableBool>
                            <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
                            <IsAction operatorType="NotEqual">PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>

                    <Transition to="Land" from="Fall">
                        <Condition>
                            <IsVariableBool name="onGround">true</IsVariableBool>
                        </Condition>
                    </Transition>

                    <Transition to="Idle" from="Land">
                        <Condition type="and">
                            <IsAnimationFinished>izumi_Land</IsAnimationFinished>
                            <IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>

                    <Transition to="Move" from="Land">
                        <Condition type="and">
                            <IsAnimationFinished>izumi_Land</IsAnimationFinished>
                            <IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
                        </Condition>
                    </Transition>

                    <Transition to="Punch" from="Idle|Move|Jump|Fall|Land|Dance|dance1|dance2|dance3|Respawn">
                        <Condition type="and">
                            <IsAction>PUNCH</IsAction>
                            <IsAction operatorType="NotEqual">DANCE</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_DAB</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_FLOSS</IsAction>
                            <IsAction operatorType="NotEqual">DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>

                    <Transition to="Dance" from="Move|Idle|Punch|Jump|Fall|Land">
                        <Condition type="or">
                            <IsAction>DANCE</IsAction>
                            <IsAction>DANCE_DAB</IsAction>
                            <IsAction>DANCE_FLOSS</IsAction>
                            <IsAction>DANCE_MARCH</IsAction>
                        </Condition>
                    </Transition>

                    <Transition to="dance1" from="Dance|dance3">
                        <Condition type="or">
                            <IsAnimationFinished>dance_anim3</IsAnimationFinished>
                            <IsState>Motion.Dance</IsState>
                        </Condition>
                    </Transition>

                    <Transition to="dance2" from="dance1">
                        <Condition>
                            <IsAnimationFinished>dance_anim1</IsAnimationFinished>
                        </Condition>
                    </Transition>

                    <Transition to="dance3" from="dance2">
                        <Condition>
                            <IsAnimationFinished>dance_anim2</IsAnimationFinished>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>

            <StateMachine name="Reveal">
                <States>
                    <State name="No" />
                    <State name="Done" />
                </States>

                <Transitions>
                    <Transition to="Done" from="No">
                        <Condition>
                            <IsAnimationFinished>izumi_PreIdle</IsAnimationFinished>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <Animations>
            <SpriteAnimation name="izumi_PreIdle" sprite="izumi_body" isLoop="false" autoPlay="true" animTime="950" playOnState="Reveal.No">
                <Frame>1,5</Frame>
                <Frame>2,5</Frame>
                <Frame>3,5</Frame>
                <Frame>4,5</Frame>
                <Frame>5,5</Frame>
                <Frame>6,5</Frame>
                <Frame>7,5</Frame>
                <Frame>8,5</Frame>
                <Frame>0,6</Frame>
                <Frame>1,6</Frame>
                <Frame>2,6</Frame>
                <Frame>3,6</Frame>
                <Frame>4,6</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Idle" sprite="izumi_body" isLoop="true" animTime="1280" playOnState="Motion.Idle">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>5,1</Frame>
                <Frame>6,1</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Move" sprite="izumi_body" isLoop="true" animTime="630" playOnState="Motion.Move">
                <Frame>8,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>3,2</Frame>
                <Frame>4,2</Frame>
                <Frame>5,2</Frame>
                <Frame>6,2</Frame>
                <Frame>7,2</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Jump" sprite="izumi_body" isLoop="false" animTime="420" playOnState="Motion.Jump">
                <Frame>8,2</Frame>
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
                <Frame>3,3</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Fall" sprite="izumi_body" isLoop="true" animTime="300" playOnState="Motion.Fall">
                <Frame>2,4</Frame>
                <Frame>3,4</Frame>
                <Frame>4,4</Frame>
                <Frame>3,4</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Land" sprite="izumi_body" isLoop="false" animTime="300" playOnState="Motion.Land">
                <Frame>5,4</Frame>
                <Frame>6,4</Frame>
                <Frame>7,4</Frame>
                <Frame>8,4</Frame>
                <Frame>0,5</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Respawn" sprite="izumi_body" isLoop="false" animTime="950" playOnState="Motion.Respawn">
                <Frame>5,6</Frame>
                <Frame>6,6</Frame>
                <Frame>7,6</Frame>
                <Frame>8,6</Frame>
                <Frame>0,7</Frame>
                <Frame>1,7</Frame>
                <Frame>2,7</Frame>
                <Frame>3,7</Frame>
                <Frame>4,7</Frame>
                <Frame>5,7</Frame>
                <Frame>6,7</Frame>
                <Frame>7,7</Frame>
                <Frame>8,7</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="izumi_Punch" sprite="izumi_punch_body" isLoop="true" animTime="1100" playOnState="Motion.Punch">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>0,1</Frame>
                <Frame>1,1</Frame>
                <Frame>2,1</Frame>
                <Frame>3,1</Frame>
                <Frame>4,1</Frame>
                <Frame>0,2</Frame>
                <Frame>1,2</Frame>
                <Frame>2,2</Frame>
                <Frame>3,2</Frame>
                <Frame>4,2</Frame>
                <Frame>0,3</Frame>
                <Frame>1,3</Frame>
                <Frame>2,3</Frame>
                <Frame>3,3</Frame>
                <Frame>4,3</Frame>
                <Frame>0,4</Frame>
                <Frame>1,4</Frame>
                <Frame>2,4</Frame>
                <Frame>3,4</Frame>
                <Frame>4,4</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="dance_anim1" sprite="izumi_body" isLoop="false" animTime="240" playOnState="Motion.dance1">
                <Frame>0,0</Frame>
                <Frame>1,0</Frame>
                <Frame>2,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="dance_anim2" sprite="izumi_body" isLoop="false" animTime="240" playOnState="Motion.dance2">
                <Frame>3,0</Frame>
                <Frame>4,0</Frame>
                <Frame>5,0</Frame>
            </SpriteAnimation>

            <SpriteAnimation name="dance_anim3" sprite="izumi_body" isLoop="false" animTime="240" playOnState="Motion.dance3">
                <Frame>6,0</Frame>
                <Frame>7,0</Frame>
                <Frame>8,0</Frame>
            </SpriteAnimation>
        </Animations>

        <RenderOptions>
            <Default>
                <Set name="JumpEndStateRange">100</Set>
                <Set name="ClothingOffsetFromShoes">10000</Set>
                <Set name="IsRidingBird">true</Set>
                <Set name="IsVehicle">true</Set>
                <Set name="IsToRenderPants">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
                <Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
                <Set name="UserNameOffset">42</Set>
                <Set name="IncludeAllActions">true</Set>
                <Set name="HideAngelOnDeath">true</Set>
                <Set name="HideAvatarOnDeath">true</Set>
                <Set name="IgnorePunchTypeCheck">true</Set>
            </Default>
        </RenderOptions>
    </Data>

    <RenderRules>
        <RenderInFront>
            <StopIf>
                <IsVariableBool name="isMannequin">true</IsVariableBool>
                <IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
            </StopIf>

            <SpriteRender name="izumi_body" offset="0,-9985" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Land|Motion.dance1|Motion.dance2|Motion.dance3|Motion.Respawn" scale="0.30,0.30" />
            <SpriteRender name="izumi_punch_body" offset="0,-9985" alignment="DOWN_CENTER" drawShadow="true" onState="Motion.Punch" scale="0.30,0.30" />
        </RenderInFront>

        <RenderShoes>
            <StopIf>
                <IsSitting>true</IsSitting>
                <IsSleepingOnaBed>true</IsSleepingOnaBed>
                <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
            </StopIf>
        </RenderShoes>
    </RenderRules>
</ItemRenderer>